# Packaging instructions for the BigWigs packager (used by the GitHub Actions).
# Everything in the repository goes into the addon zip EXCEPT what's listed here.
package-as: LoadoutPlanner

ignore:
  - tools
  - VERSION
  - CLAUDE.md

# The release notes CurseForge and GitHub show for each version.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
